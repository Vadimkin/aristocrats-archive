# Dependencies
node_modules/

# Build output
dist/

# Generated by `npm run data` (scripts/build-data.mjs) — exported from db/
public/data/

# db/aristocrats.db and db/migrations/ ARE committed: the database is the
# source of truth. Only SQLite's transient sidecar files are ignored.
db/*.db-wal
db/*.db-shm

# Vite / tooling caches
.vite/
*.tsbuildinfo

# Local env & secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-error.log*

# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# Editors
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp

# Claude Code local overrides (keep .claude/settings.json shared)
.claude/settings.local.json
